<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Chat</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <form action="/chats" method="post" class="new-chat-form">
        <input type="text" name="from" placeholder="Sender's Name'">
        <br>
        <textarea name="msg" placeholder="Type your message here"></textarea>
        <br>
        <input type="text" name="to" placeholder="Receiver's Name'">
        <button>Submit</button>
    </form>
</body>
</html>